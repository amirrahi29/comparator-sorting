Q. What is TypeScript?
    Answer:
    -------
        TypeScript, JavaScript का superset है, जिसमें static type checking मिलती है। इससे code लिखते समय type-related errors पकड़े जा सकते हैं।

            let username: string = "Rahul";
            let age: number = 30;
            username = 100; // Error: number is not assignable to string

2. What is the difference between type and interface?
    Answer:
    -------
        Interface
        ---------
              interface Person{
                name: string
              }

              interface Details extends Person{
                age: number
              }

              const details: Details = {
                name: "akhil",
                age: 33
              }

              // display output
              <h2>Name: {details.name}</h2>
              <h2>Age: {details.age}</h2>

        type
        -----
              type Person={
                name:string
              }

              type Details = Person & {
                age: number
              }

              const details: Details={
                  name:"amir",
                  age: 30
              }

              // display output
              <h3>Name: {details.name}</h3>
              <h3>Age: {details.age}</h3>

3. What is the difference between any, unknown, and never?
    Answer
    ------
        any
        ----
            let a: any = 20;

            a = "Hello";    // ✅ Valid
            a = true;      // ✅ Valid
            a = { name: "Akhil" }; // ✅ Valid

        unknown
        -------
            let data: unknown = 20;

            // console.log(data.toUpperCase()); // ❌ Error

            if (typeof data === "string") {
              console.log(data.toUpperCase());
            } else if (typeof data === "number") {
              console.log(data.toFixed(2));
            }

        never
        -----
            function fail(): never {
              throw new Error("Failed");
            }

            function infinite(): never {
              while (true) {
                 // Never ends
              }
            }

            <h3>Name: {infinite()}</h3>

